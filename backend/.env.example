# Local development only; use Supabase PostgreSQL for deployed environments.
DATABASE_URL=sqlite:///./edupath.db
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY
FRONTEND_ORIGIN=http://localhost:5173
# Optional: enables personalized AI graph generation. The API falls back to a staged roadmap without it.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
