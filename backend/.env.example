# PostgreSQL URL from Supabase or SQLite for local development.
DATABASE_URL=sqlite:///./edupath.db

# Backend-only Supabase public project credentials, used to verify access tokens.
# These are not service-role credentials. Set both on Render.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Set this to the exact Vercel frontend origin; FRONTEND_ORIGIN is also accepted.
FRONTEND_URL=https://edu-path-ai-seven.vercel.app
