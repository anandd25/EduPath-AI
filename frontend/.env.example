# EduPath Environment Configuration

# Supabase Authentication Configuration
# Found in your Supabase Dashboard: Project Settings -> API -> Project URL & Project API Keys (anon/public)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_publishable_or_anon_key"

# Backend API Base URL
# Local FastAPI development: http://localhost:8000
# Production Render backend: https://edupath-ai-backend-9van.onrender.com
VITE_API_BASE="https://edupath-ai-backend-9van.onrender.com"

# GEMINI_API_KEY: Reserved for future AI pathway recommendation and scenario generation
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
