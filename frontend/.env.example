# EduPath Environment Configuration

# Keep these names aligned with the Vercel environment variables.
# Use only the public anon/publishable key, never a service-role key.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_publishable_or_anon_key"

# Backend API Base URL
VITE_API_BASE="https://edupath-ai-backend-9van.onrender.com"

# GEMINI_API_KEY: server-side only; do not expose as a VITE_ variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
